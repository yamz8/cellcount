pkgname=cellcount
pkgver=0.1.0
pkgrel=1
pkgdesc='Count cells or colonies on microscope and plate images by clicking'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/cellcount'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/cellcount "$pkgdir/usr/bin/cellcount"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/cellcount.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cellcount.svg"
  install -Dm644 "$startdir/cellcount.desktop" "$pkgdir/usr/share/applications/cellcount.desktop"
}
